# Copy this file to .env and adjust values if needed. The defaults below
# work out of the box for local development - there is no need to change
# anything to get the project running.
#
#   cp .env.example .env

# PostgreSQL (shared by the warehouse, Airflow's metadata DB, and
# Superset's metadata DB - each lives in its own database within this one
# instance, see postgres/init/*.sql)
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_local_pw
POSTGRES_DB=fintech
POSTGRES_PORT=5432

# Superset requires a SECRET_KEY (used to sign sessions/CSRF tokens).
# Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The value below is a placeholder - fine for local use, but generate a
# fresh one if you plan to expose this beyond your own machine.
SUPERSET_SECRET_KEY=d3e070892af5f94e75353e942a062aa9534d86be6249ad7c38d6c945221d7205
